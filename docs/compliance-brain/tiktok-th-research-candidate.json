      "sourceIds": [
        "price"
      ],
      "semanticCategories": [
        "MISLEADING_PRICE"
      ],
      "obligation": "Prices, discounts and delivery claims must match the applicable product listing and current promotion. State voucher, eligibility, minimum-spend, bundle and validity conditions; do not invent pricing errors or disguise bundle prices as unrestricted unit prices.",
      "severity": "HIGH",
      "recommendedDecision": "REVIEW_REQUIRED",
      "contentTypes": [
        "POST",
        "LIVE"
      ],
