        "RESTRICTED_PRODUCT"
      ],
      "obligation": "Do not promote prohibited or unsupported products. Check category approval and applicable restrictions before promoting restricted products.",
      "severity": "CRITICAL",
      "recommendedDecision": "BLOCK",
      "contentTypes": [
        "POST",
        "LIVE"
