        "FALSE_BEFORE_AFTER",
        "TIME_BOUND_RESULT"
      ],
      "obligation": "Do not fabricate appearance transformations, AI results or misleading beauty-filter demonstrations. Temporary makeup or concealment effects must be clearly cosmetic and accurately shown.",
      "severity": "HIGH",
      "recommendedDecision": "REVIEW_REQUIRED",
