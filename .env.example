# Public Supabase values from Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only safeguard. Enable only in a local development environment.
ALLOW_DEV_MOCK_SEED=false

# Creative Brain defaults to deterministic, free mock generation.
CREATIVE_AI_PROVIDER=mock
CREATIVE_AI_MODEL=gpt-5.4-nano
# Required only when CREATIVE_AI_PROVIDER=openai. Never commit a real key.
OPENAI_API_KEY=

# Phase 6B real-provider benchmark. Server/CLI only; never expose this key.
RUNWAYML_API_SECRET=
# Paid calls require both an explicit opt-in and a hard total cap.
VIDEO_BENCHMARK_ALLOW_PAID=false
VIDEO_BENCHMARK_MAX_USD=0
