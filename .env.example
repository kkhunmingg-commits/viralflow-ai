# REQUIRED_FOR_BOOT: environment identity and public Supabase values.
# APP_ENV defaults to development locally; set explicitly in staging/production.
APP_ENV=development
# REQUIRED_FOR_BOOT outside development: exact HTTPS origin, with no path.
APP_URL=
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# REQUIRED_FOR_FEATURE: server-only key for OAuth, rate limits, recovery and protected records.
SUPABASE_SECRET_KEY=sb_secret_your_key
# REQUIRED_FOR_FEATURE: set OPS_RECOVERY_ENABLED=true only after checking live alerts and owner sign-off.
OPS_RECOVERY_ENABLED=false
# Vercel Cron adds Authorization: Bearer CRON_SECRET for scheduled GET requests.
CRON_SECRET=
# Optional independent token for manual/externally scheduled POST requests.
OPS_RECOVERY_TOKEN=
# OPTIONAL: generic HTTPS alert destination; exact host is required when URL is set.
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_HOST=
OPS_ALERT_WEBHOOK_TOKEN=

# REQUIRED_FOR_FEATURE: TikTok OAuth. Mock makes no TikTok request.
TIKTOK_PROVIDER=mock
# Use basic with Sandbox credentials; switch to publishing only after TikTok approves video scopes.
TIKTOK_OAUTH_SCOPE_MODE=publishing
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-domain.example/auth/tiktok/callback
# At least 32 random characters, used only on the server for AES-GCM encryption.
TIKTOK_TOKEN_ENCRYPTION_KEY=
# App approval is distinct from the scopes each user grants.
TIKTOK_VIDEO_PUBLISH_APPROVED=false
TIKTOK_VIDEO_UPLOAD_APPROVED=false
TIKTOK_DIRECT_POST_AUDIT_STATUS=UNAUDITED
TIKTOK_CREATOR_CACHE_TTL_SECONDS=300

# REQUIRED_FOR_FEATURE: publishing remains mock-only unless official, production,
# app approval and the explicit real-mode flag are all present.
TIKTOK_PUBLISHING_PROVIDER=mock
TIKTOK_PUBLISHING_REAL_MODE=false
TIKTOK_ANALYTICS_PROVIDER=mock
TIKTOK_ANALYTICS_REAL_MODE=false
# Comma-separated exact HTTPS hostnames already verified in TikTok Developer Portal.
TIKTOK_ALLOWED_PULL_HOSTS=
# Exact TikTok-owned upload hosts returned by the official Content Posting API.
TIKTOK_ALLOWED_UPLOAD_HOSTS=open-upload.tiktokapis.com,upload.us.tiktokapis.com
TIKTOK_WEBHOOK_TOLERANCE_SECONDS=300
TIKTOK_WEBHOOK_MAX_BYTES=65536
TIKTOK_WEBHOOK_RATE_LIMIT=120
TIKTOK_OAUTH_RATE_LIMIT=20
AUTHENTICATED_MUTATION_RATE_LIMIT=60

# REQUIRED_FOR_FEATURE: TikTok Shop remains mock-first. Official mode also requires Partner
# Center approval and uses server-only credentials with the Phase 7A encryption pattern.
TIKTOK_SHOP_PROVIDER=mock
TIKTOK_SHOP_REAL_MODE=false
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=

# Server-only safeguard. Enable only in a local development environment.
ALLOW_DEV_MOCK_SEED=false

# OPTIONAL: override bundled FFmpeg/FFprobe binaries when the host provides
# a build with drawtext support (for example, the CI runner).
FFMPEG_BINARY=
FFPROBE_BINARY=

# OPTIONAL: Creative Brain defaults to deterministic, free mock generation.
CREATIVE_AI_PROVIDER=mock
CREATIVE_AI_MODEL=gpt-5.4-nano
# Required only when CREATIVE_AI_PROVIDER=openai. Never commit a real key.
OPENAI_API_KEY=

# REQUIRED_FOR_FEATURE: real video providers. All keys are server/CLI only.
GOOGLE_GENAI_API_KEY=
GOOGLE_VEO_MODEL=VEO_3_1_LITE
RUNWAYML_API_SECRET=
FAL_KEY=
FAL_WAN_PROVIDER_STATE=PRIMARY_CANDIDATE
VIDEO_PRODUCT_IMAGE_ALLOWED_HOSTS=
PIXVERSE_API_KEY=
# Conservative default for package credits: $10 / 1,000 credits.
PIXVERSE_USD_PER_CREDIT=0.01
# Paid benchmark is a separate CLI flow. Keep it false in staging and production.
VIDEO_BENCHMARK_ALLOW_PAID=false
VIDEO_BENCHMARK_MAX_USD=0
