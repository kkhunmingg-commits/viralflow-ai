import {readFile,writeFile} from 'node:fs/promises';
import {resolve} from 'node:path';
const path=resolve('.video-benchmark/economy-20261013/manifest.json'),m=JSON.parse(await readFile(path,'utf8'));
const reviews:Record<string,unknown>={
 'beauty-wan480-a':{reviewBasis:'Assistant inspection of real sampled frames, not a paid vision model',nativeEightSeconds:false,usableFullGeneratedShot:false,usableSegmentSeconds:2.8,productFidelity:5,logoPreservation:6,textPreservation:5,temporalConsistency:4,motionQuality:5,promptAdherence:2,artifactSeverity:7,failureReason:'Unrequested hands; product shrinks and changes shape near the end. Full shot rejected; short stable section can be edited with original reference.'},
 'beauty-ltx8-a':{reviewBasis:'Assistant inspection of real sampled frames',nativeEightSeconds:true,usableFullGeneratedShot:false,productFidelity:5,logoPreservation:7,textPreservation:2,temporalConsistency:8,motionQuality:2,promptAdherence:4,artifactSeverity:7,failureReason:'SERUM B-01 and 30 mL replaced with incorrect text. Largely static shot. Not acceptable for label-sensitive product advertising.'},
 'beauty-wan720-stable':{reviewBasis:'Assistant inspection at half-second intervals plus full-resolution frame; not all-frame certification',nativeEightSeconds:false,usableFullGeneratedShot:true,productFidelity:8,logoPreservation:8,textPreservation:8,temporalConsistency:8,motionQuality:6,promptAdherence:8,artifactSeverity:2,failureReason:null,limitations:['Native generated source only 5.032 seconds','Basic lighting motion, no product interaction benchmark','Single fictional beauty fixture, not proof for all products','No Thai voiceover tested']}
};
for(const sample of m.samples)sample.visualReview=reviews[sample.name];
m.summary={generatedRequests:m.samples.length,conservativeCatalogTotalUsd:m.samples.reduce((sum:number,s:{estimateUsd:number})=>sum+s.estimateUsd,0),reservedTotalUsd:m.samples.reduce((sum:number,s:{reserveUsd:number})=>sum+s.reserveUsd,0),actualBillingTotalUsd:null,billingReason:'Existing API key lacks billing read permission; no invoice amount fabricated',nativeEightSecondWithin5ThbWinner:null,economyAdCandidate:'beauty-wan720-stable-ad8-hybrid.mp4',economyAdCostEstimateUsd:.1,economyAdCostEstimateThb:.1*m.fxPlanningThbPerUsd,economyAdStructure:'5 seconds real generated video + 3 seconds original licensed fixture product image/end card',paidMusicCostUsd:0,voiceover:false,usableCostLongRunUsd:null,usableCostReason:'One successful 720p revised prompt is insufficient to establish production pass rate; benchmark failures cost money too',paidProductionEnabled:false,productionDatabaseChanges:0,tiktokCalls:0};
await writeFile(path,JSON.stringify(m,null,2));
console.log(JSON.stringify(m.summary));
