import {readFile,writeFile,rename,appendFile} from 'node:fs/promises';
const root='.video-benchmark/economy-20261013',path=root+'/manifest.json';
const m=JSON.parse(await readFile(path,'utf8'));
const s=m.samples.find((s:{name:string})=>s.name==='mop-wan26-10-interaction');
if(s?.state!=='COMPLETE')throw new Error('Completed original request required');
s.visualReview={reviewBasis:'Assistant visual screening at half-second intervals plus full-resolution frames at 2/6/8 seconds, not all-frame certification or a paid vision assessment',productFidelity:8,handQuality:8,temporalConsistency:8,motionQuality:7,productInteraction:6,promptAdherence:7,artifactSeverity:3,nativeEightSeconds:true,sourceGeneratedSeconds:10,usableFullGeneratedShot:null,decision:'OWNER_REVIEW_REQUIRED',severeSampledDefect:false,observations:['Bucket silhouette, rim, shaft and two visible hands remain coherent in sampled frames','White mop fibers and metal basket show rotation while the lower shaft remains seated','No detached-looking hand or invented large blue connector seen in inspected frames','Finger grip and downward pressing action are less convincing and less forceful than owner reference'],limitations:['Silent source; no voiceover or generated audio requested','One output is insufficient to establish reliability or production usable cost','No inference about real cleaning effectiveness, product claims or TikTok compliance'],failureReason:null};
s.freezeScreening={tool:'Local FFmpeg freezedetect',thresholdDb:-50,minimumDurationSeconds:1,reportedFreezeIntervals:0,decodedFrames:300,decodeError:false};
m.summary={...m.summary,referenceMatchingCandidate:s.name,referenceMatchingUsableCount:0,ownerAcceptedCount:0,correctedRequirementMet:false,correctedRequirementStatus:'VISUAL_CANDIDATE_PENDING_OWNER_REVIEW_AND_OVER_5_THB',nativeEightSecondWithin5ThbWinner:null,usableCostLongRunUsd:null,usableCostReason:'Owner has not accepted this single candidate; no reliability/usable-cost claim justified',economyAdCostEstimateUsd:null,economyAdCostEstimateThb:null,economyAdStructure:null,latestTrialRequests:1,latestTrialConservativeEstimateUsd:.5,latestTrialSilentCatalogEstimateUsd:.25,latestTrialReservationUsd:.55,latestTrialActualBillingUsd:null,paidProductionEnabled:false,productionDatabaseChanges:0,tiktokCalls:0};
await writeFile(root+'/manifest.tmp',JSON.stringify(m,null,2));await rename(root+'/manifest.tmp',path);
await appendFile(root+'/REPORT.md',`\n\n## Additional owner-authorized WAN-only trial\n\nOwner requested another economical experiment after reviewing the prior failures. One new request only was authorized locally with an announced additional cap of $0.60. The ledger preserves the earlier five requests and reservations; it does not reset previous costs. New cumulative reservation cap $1.350753; actually reserved cumulative $1.300753.\n\nWAN 2.6 Flash, 720p, generate_audio=false, duration=10, seed=1001, prompt expansion/multi-shots disabled, safety checker enabled. Request ${s.requestId}. Generated in ${(s.latencyMs/1000).toFixed(3)}s. Original MP4 is 10.000s, 720x1280, 30fps, H.264, 300 decoded frames, silent. No cut, freeze padding, looping, slowdown or end card was added. File: ${s.output}. The source prompt describes the eight-second target while the endpoint supplies ten native seconds (supported durations are 5/10/15).\n\nOfficial pricing API/public audio-on quote $0.05/s: conservative estimate $0.50; reservation $0.55. Official schema states silent generation is half the flash audio price, giving an expected silent catalog estimate $0.25 (~8.38 THB using the ledger planning FX), NOT an invoice. Actual billing remains UNKNOWN. Conservative estimate for ALL SIX attempts is $1.182500 (~39.65 THB); if the documented WAN silent discount applies, catalog-only total would be $0.932500 (~31.27 THB). Neither total is claimed as actual billed spend.\n\nSampled visual screening found much better product/hand continuity than the LTX attempts and a rotating mop/spinner with a seated lower shaft. The grip and force of the pumping action are weaker than the owner's reference. Candidate status is OWNER_REVIEW_REQUIRED, not an accepted production ad. One sample does not prove reliability or usable cost. No severe detached hand/large invented blue connector was seen in the sampled frames. Full-resolution 2/6/8s frames were checked. Local freeze detection at -50dB/minimum 1s reported no freeze intervals; this is not comprehensive motion/physical correctness certification.\n\nThe 5 THB target is still NOT met at the catalog silent estimate. No further purchase was made, no TikTok call, no paid audio call, no Production database/config/deployment change. All files are ignored local benchmark artifacts; no secret was written into them.\n`);
console.log(JSON.stringify({latestTrialRequests:1,status:s.visualReview.decision,sourceSeconds:10,silentCatalogEstimateUsd:.25,conservativeEstimateUsd:.5,reservedUsd:.55,actualBillingUsd:null,withinFiveThb:false,furtherSubmissions:0}));
