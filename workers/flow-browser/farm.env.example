# Copy to farm.env (same folder, never committed) and fill in.
# The ViralFlow site the library lives on (or http://localhost:3000 when running locally).
FLOW_PORTAL_URL=https://viralflow-ai-blond.vercel.app
# Same long random value as FLOW_WORKER_TOKEN on the server (at least 32 characters).
FLOW_WORKER_TOKEN=
# offscreen = real Chrome window placed off the screen (default), headless = no window, visible = for checking.
FLOW_WINDOW=offscreen
# Use the installed Google Chrome.
FLOW_CHROME_CHANNEL=chrome
# Free-first: never click Generate if Flow says one clip costs more than this (Veo 3.1 - Lite x1 = 10).
FLOW_MAX_CREDITS_PER_CLIP=10
# How often --watch checks the queue.
FLOW_WATCH_SECONDS=60
